# Ollama endpoint (local AI, no cloud calls unless you change this)
OLLAMA_URL=http://localhost:11434

# Default models — can also be changed at runtime from the Settings page
CAREERFORGE_REASONING_MODEL=qwen2.5:14b
CAREERFORGE_EMBEDDING_MODEL=nomic-embed-text
CAREERFORGE_VISION_MODEL=granite3.2-vision
